# Access Token do Mercado Pago (Painel de Desenvolvedores > Suas integrações > Credenciais)
# Comece com o de TESTE (começa com TEST-...) e só troque para o de PRODUÇÃO quando for cobrar de verdade.
MP_ACCESS_TOKEN=TEST-COLE_SEU_ACCESS_TOKEN_AQUI

# Chave secreta simples só sua e do app, pra impedir que qualquer pessoa da internet
# chame sua API diretamente. Troque por qualquer texto aleatório longo.
APP_API_KEY=troque-por-um-texto-secreto-bem-comprido

# E-mail do vendedor, usado como e-mail do pagador de teste (ajuste em produção
# para pedir o e-mail real do cliente, se quiser).
EMAIL_PADRAO_PAGADOR=comprador@teste.com

# Preço da licença (em reais) e duração do teste grátis
PRECO_LICENCA=19.90
DIAS_TESTE_GRATIS=30
DIAS_VALIDADE_LICENCA=30

# Porta local (a maioria dos provedores de hospedagem ignora isso e define a própria)
PORT=3000

# Usuário e senha do PAINEL ADMINISTRATIVO (https://SEU-BACKEND/admin)
# Troque a senha por algo forte e só seu — quem tiver essa senha pode liberar
# ou bloquear qualquer cliente.
ADMIN_USER=admin
ADMIN_PASSWORD=troque-por-uma-senha-forte-so-sua
